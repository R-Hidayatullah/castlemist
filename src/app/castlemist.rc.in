// Win32 resources for castlemist.exe -- configured by CMake into the build
// tree; edit castlemist.rc.in, never the generated copy.
//
// Everything variable is substituted at configure time rather than passed on
// the command line, because MinGW's windres builds its preprocessor invocation
// as an unquoted shell string: a -D holding a quoted version string, or a -I
// pointing anywhere with a space in it, makes the whole command fall apart.
// Nothing here needs -D or -I, so nothing here can hit that.
//
//   IDI_APPICON  the icon, so Explorer, the taskbar and Alt-Tab have something
//                to show. Generated by tools/branding/make_icon.py.
//   the manifest themed common controls *and* per-monitor DPI awareness. The
//                v6 dependency used to be activated at runtime by writing a
//                temp manifest and calling CreateActCtx; embedded here it
//                applies before the first window exists, and it can declare
//                DPI awareness, which an activation context cannot.

#include <windows.h>

// Keep in step with IDI_APPICON in src/app/resource.h. Spelled numerically
// because resource.h cannot be reached without -I -- see above.
#define IDI_APPICON 1

// The lowest-numbered icon resource is the one Explorer shows, so this
// stays first.
IDI_APPICON ICON "@CM_ICON_PATH@"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "@CM_MANIFEST_PATH@"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION     @CM_VER_MAJOR@, @CM_VER_MINOR@, @CM_VER_PATCH@, 0
    PRODUCTVERSION  @CM_VER_MAJOR@, @CM_VER_MINOR@, @CM_VER_PATCH@, 0
    FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
    FILEFLAGS       0
    FILEOS          VOS_NT_WINDOWS32
    FILETYPE        VFT_APP
    FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"   // US English, Unicode
        BEGIN
            VALUE "CompanyName",      "castlemist"
            VALUE "FileDescription",  "Guild Wars 2 .dat explorer"
            VALUE "FileVersion",      "@CM_VER_STRING@"
            VALUE "InternalName",     "castlemist"
            VALUE "LegalCopyright",   "MIT licensed. Not affiliated with ArenaNet or NCSOFT."
            VALUE "OriginalFilename", "castlemist.exe"
            VALUE "ProductName",      "castlemist"
            VALUE "ProductVersion",   "@CM_VER_STRING@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
