# Normalise line endings in history, check out native on Windows.
* text=auto

*.c      text diff=cpp
*.h      text diff=cpp
*.cpp    text diff=cpp
*.hpp    text diff=cpp
*.py     text diff=python
*.md     text diff=markdown
*.cmake  text
*.txt    text
*.json   text
*.ps1    text eol=crlf
*.bat    text eol=crlf
*.sh     text eol=lf

# Binary blobs the tools produce or consume.
*.dat    binary
*.dll    binary
*.exe    binary
*.db     binary
*.rdc    binary
*.png    binary
*.dds    binary
*.bin    binary
